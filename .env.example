PORTAL_CLIENT_ID=eggless-observability
PORTAL_REDIRECT_URI=https://eggless.tanmaysinghx.com/auth/callback
PORTAL_SCOPES=openid profile email
PORTAL_CLIENT_SECRET=
PORTAL_API_KEY=
PORTAL_APP_ID=5de93ba7-0673-4fba-8e9b-a1bdb8466f03
PORTAL_LOGIN_ENDPOINT=https://portal.tanmaysinghx.com/api/external/apps/5de93ba7-0673-4fba-8e9b-a1bdb8466f03/login
PORTAL_REGISTER_ENDPOINT=https://portal.tanmaysinghx.com/api/external/apps/5de93ba7-0673-4fba-8e9b-a1bdb8466f03/register
